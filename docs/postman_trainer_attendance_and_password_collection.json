{
  "info": {
    "_postman_id": "f83a69b1-582c-47bc-8ef2-trainer-attendance-auth",
    "name": "JETZ Academy - Trainer Attendance & Password Management API",
    "description": "Postman collection covering Trainer Attendance (check-ins, correction requests, approvals/rejections, automation config, leaves) and Password Management (self-service password change, admin one-time temporary password reset).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "coachId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "checkinId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "correctionId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Authentication",
      "item": [
        {
          "name": "Login (Admin / Coach)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "    pm.environment.set('token', jsonData.access);",
                  "    console.log('JWT Token successfully set in variables.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"coach1\",\n  \"password\": \"Jetz@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", ""]
            },
            "description": "Log in to retrieve JWT access & refresh tokens. Automatically sets `token` collection variable."
          },
          "response": []
        },
        {
          "name": "Login as Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access) {",
                  "    pm.collectionVariables.set('token', jsonData.access);",
                  "    pm.environment.set('token', jsonData.access);",
                  "    console.log('Super Admin Token set.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Jetz@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", ""]
            },
            "description": "Log in as Super Admin to test administrative operations such as password reset or correction approvals."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Password Management",
      "item": [
        {
          "name": "Self-Service Change Password (/auth/change-password/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"Jetz@123\",\n  \"new_password\": \"JetzSecure@2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password", ""]
            },
            "description": "Self-service password update for the currently authenticated user. Clears the `must_change_password` first-login flag. Requires current password verification and min 8 characters."
          },
          "response": []
        },
        {
          "name": "Admin Reset User Password (/users/:id/reset_password/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{targetUserId}}/reset_password/",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{targetUserId}}", "reset_password", ""]
            },
            "description": "Administrative password reset. Generates a random 12-character one-time temporary password, sets `must_change_password = True` on the user, and returns the temporary password in plaintext (shown once). Permission: Super Admin or Admin managing users."
          },
          "response": []
        },
        {
          "name": "Password Reset Request (/auth/password-reset/)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"coach@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password-reset/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "password-reset", ""]
            },
            "description": "Public reset request endpoint. Returns 501 / administrative instructions as configured for this installation."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Trainer Attendance Check-Ins",
      "item": [
        {
          "name": "List Trainer Check-Ins (/coaches/checkins/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/checkins/?coach={{coachId}}&session=&status=&date_from=&date_to=&page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "checkins", ""],
              "query": [
                {
                  "key": "coach",
                  "value": "{{coachId}}",
                  "description": "Filter by coach profile ID"
                },
                {
                  "key": "session",
                  "value": "",
                  "description": "Filter by session ID"
                },
                {
                  "key": "status",
                  "value": "",
                  "description": "present, late, absent, leave"
                },
                {
                  "key": "date_from",
                  "value": "",
                  "description": "Filter start date (YYYY-MM-DD)"
                },
                {
                  "key": "date_to",
                  "value": "",
                  "description": "Filter end date (YYYY-MM-DD)"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "List trainer check-in records. Coaches see their own records; administrators see all trainers in their academy scope."
          },
          "response": []
        },
        {
          "name": "Create Trainer Check-In (/coaches/checkins/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session\": {{sessionId}},\n  \"status\": \"present\",\n  \"notes\": \"Checked in on court\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/checkins/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "checkins", ""]
            },
            "description": "Record coach's own attendance for an assigned session. Status choices: present, late, absent, leave. Enforces unique (session, coach)."
          },
          "response": []
        },
        {
          "name": "Get Check-In by ID (/coaches/checkins/:id/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/checkins/{{checkinId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "checkins", "{{checkinId}}", ""]
            },
            "description": "Retrieve specific check-in details including auto_marked flag, marked_at timestamp, and notes."
          },
          "response": []
        },
        {
          "name": "Update / Correct Own Check-In (/coaches/checkins/:id/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"late\",\n  \"notes\": \"Delayed 10 mins by traffic\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/checkins/{{checkinId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "checkins", "{{checkinId}}", ""]
            },
            "description": "Coach corrects their own manual check-in status or notes. (Note: auto-marked absences cannot be changed via PATCH; they require a correction request via /coaches/corrections/)."
          },
          "response": []
        },
        {
          "name": "Delete Check-In (/coaches/checkins/:id/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/checkins/{{checkinId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "checkins", "{{checkinId}}", ""]
            },
            "description": "Delete a trainer check-in record. Requires `coaches.manage` permission."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Trainer Attendance Correction Requests",
      "item": [
        {
          "name": "List Correction Requests (/coaches/corrections/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/corrections/?coach={{coachId}}&status=pending&checkin=&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "corrections", ""],
              "query": [
                {
                  "key": "coach",
                  "value": "{{coachId}}",
                  "description": "Filter by coach profile ID"
                },
                {
                  "key": "status",
                  "value": "pending",
                  "description": "Filter by pending, approved, or rejected"
                },
                {
                  "key": "checkin",
                  "value": "",
                  "description": "Filter by check-in ID"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "List attendance correction requests. Used by coaches to track their requests and by admins to review pending claims."
          },
          "response": []
        },
        {
          "name": "Submit Correction Request (/coaches/corrections/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkin\": {{checkinId}},\n  \"requested_status\": \"present\",\n  \"reason\": \"Phone battery died before morning session; conducted entire training session\",\n  \"evidence_note\": \"Photos taken with athletes and attendance marked manually on sheet\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/corrections/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "corrections", ""]
            },
            "description": "Coach submits a formal request to fix an automatically-marked absence. Must be submitted within the configured window (e.g. 7 days)."
          },
          "response": []
        },
        {
          "name": "Approve Correction Request (/coaches/corrections/:id/approve/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requested_status\": \"present\",\n  \"note\": \"Verified on field by Academy Manager\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/corrections/{{correctionId}}/approve/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "corrections", "{{correctionId}}", "approve", ""]
            },
            "description": "Admin or authorized role approves the correction request. Updates the underlying CheckIn status, clears `auto_marked`, and records reviewer timestamp and note. Requires `attendance.correct` or Super Admin."
          },
          "response": []
        },
        {
          "name": "Reject Correction Request (/coaches/corrections/:id/reject/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"No record or proof of trainer presence during the scheduled session time.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/corrections/{{correctionId}}/reject/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "corrections", "{{correctionId}}", "reject", ""]
            },
            "description": "Admin rejects the correction request. Mandatory `note` required. Requires `attendance.correct` or Super Admin."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Trainer Attendance Automation Settings",
      "item": [
        {
          "name": "Get Automation Settings (/coaches/attendance-config/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/attendance-config/?school=",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "attendance-config", ""],
              "query": [
                {
                  "key": "school",
                  "value": "",
                  "description": "Optional school ID for tenant-specific configuration"
                }
              ]
            },
            "description": "Read configuration for automatic trainer absence sweeps, deadlines, and approval roles. Requires `settings.view`."
          },
          "response": []
        },
        {
          "name": "Update Automation Settings (/coaches/attendance-config/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": [\n    {\n      \"key\": \"trainer.auto_absence_enabled\",\n      \"value\": true\n    },\n    {\n      \"key\": \"trainer.checkin_deadline_minutes\",\n      \"value\": 30\n    },\n    {\n      \"key\": \"trainer.correction_deadline_days\",\n      \"value\": 7\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/attendance-config/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "attendance-config", ""]
            },
            "description": "Update trainer absence automation parameters. Requires `settings.edit`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Trainer Leaves",
      "item": [
        {
          "name": "List Trainer Leaves (/coaches/leaves/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/coaches/leaves/?page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "leaves", ""],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "List trainer leave requests. Approved leaves protect coaches from being auto-marked absent."
          },
          "response": []
        },
        {
          "name": "Request Trainer Leave (/coaches/leaves/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-10-25\",\n  \"session\": {{sessionId}},\n  \"reason\": \"Medical appointment\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/leaves/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "leaves", ""]
            },
            "description": "Coach submits a planned leave request for a date or specific session."
          },
          "response": []
        },
        {
          "name": "Decide Leave Request (/coaches/leaves/:id/decide/)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Approved by Academy Director\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/coaches/leaves/1/decide/",
              "host": ["{{baseUrl}}"],
              "path": ["coaches", "leaves", "1", "decide", ""]
            },
            "description": "Admin approves or rejects a trainer leave request. Requires `coaches.manage`."
          },
          "response": []
        }
      ]
    }
  ]
}
